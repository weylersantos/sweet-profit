generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum unitCategory {
  KILOGRAMAS
  GRAMAS
  ML
  LITROS
  UNIDADE
}

enum saleMethod {
  PERCENTAGE
  FIXED
}

model user {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  email       String       @unique
  password    String
  ingredients ingredient[]
  recipes     recipe[]

  @@map("users")
}

model ingredient {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  name        String
  unit        unitCategory 
  amount      Decimal            @db.Decimal
  price       Decimal            @db.Decimal
  description String?
  
  users        user               @relation(fields: [userId], references: [id])
  recipes     recipeIngredient[]

  @@map("ingredients")
}

model recipe {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  name        String
  description String?

  users        user               @relation(fields: [userId], references: [id])
  ingredients recipeIngredient[]
  salePrice   SalePrice?

  @@map("recipes")
}

model recipeIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @db.Uuid
  ingredientId String     @db.Uuid
  unitUsed     unitCategory
  amountUsed   Decimal    @db.Decimal(10, 3)
  price        Decimal    @db.Decimal(10, 2)

  recipes       recipe     @relation(fields: [recipeId], references: [id])
  ingredients   ingredient @relation(fields: [ingredientId], references: [id])

  @@map("recipes_ingredients")
}

model SalePrice {
  id         String     @id @default(uuid())
  recipeId   String     @unique @db.Uuid
  method     saleMethod 
  value      Decimal    @db.Decimal(10, 2)
  finalPrice Decimal    @db.Decimal(10, 2)

  recipes     recipe     @relation(fields: [recipeId], references: [id])

 @@map("sale_price")
}