generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngredientCategory {
  KILOGRAMAS
  GRAMAS
  ML
  LITROS
  UNIDADE
}

enum saleMethod {
  MARGEM
  VALOR_FIXO
}

model user {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  email       String       @unique
  password    String
  ingredients ingredient[]
  recipes     recipe[]

  @@map("users")
}

model ingredient {
  id          String             @id @default(uuid()) @db.Uuid
  createdBy   String             @db.Uuid
  name        String
  category    IngredientCategory 
  amount      Decimal            @db.Decimal
  price       Decimal            @db.Decimal
  description String
  
  users        user               @relation(fields: [createdBy], references: [id])
  recipes     recipeIngredient[]

  @@map("ingredients")
}

model recipe {
  id          String             @id @default(uuid()) @db.Uuid
  createdBy   String             @db.Uuid
  name        String
  description String

  users        user               @relation(fields: [createdBy], references: [id])
  ingredients recipeIngredient[]
  salePrice   SalePrice?

  @@map("recipes")
}

model recipeIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @db.Uuid
  ingredientId String     @db.Uuid
  category     IngredientCategory
  amount       Decimal    @db.Decimal
  price        Decimal    @db.Decimal

  recipes       recipe     @relation(fields: [recipeId], references: [id])
  ingredients   ingredient @relation(fields: [ingredientId], references: [id])

  @@map("recipes_ingredients")
}

model SalePrice {
  recipeId   String     @id @db.Uuid
  totalPrice Decimal    @db.Decimal
  method     saleMethod 
  amount     Decimal    @db.Decimal
  finalPrice Decimal    @db.Decimal

  recipes     recipe     @relation(fields: [recipeId], references: [id])

 @@map("sale_price")
}